{
  "name": "@jab/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ./scripts/run-prisma.mjs generate",
    "migrate": "node ./scripts/run-prisma.mjs migrate dev",
    "migrate:deploy": "node ./scripts/run-prisma.mjs migrate deploy",
    "migrate:status": "node ./scripts/run-prisma.mjs migrate status",
    "push": "node ./scripts/run-prisma.mjs db push",
    "seed": "tsx prisma/seed.ts",
    "studio": "node ./scripts/run-prisma.mjs studio",
    "validate": "node ./scripts/run-prisma.mjs validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "prisma": "^7.10.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
