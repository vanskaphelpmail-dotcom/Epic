{
  "name": "jersey-addicts-bd",
  "private": true,
  "version": "1.0.0",
  "description": "Jersey Addicts BD monorepo — Next.js web + Prisma DB + API server packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jab/web",
    "build": "npm run generate -w @jab/db && npm run build -w @jab/web",
    "build:web": "npm run build -w @jab/web",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "npm run start -w @jab/web",
    "lint": "npm run type-check -w @jab/web",
    "type-check": "npm run type-check -w @jab/web",
    "db:generate": "npm run generate -w @jab/db",
    "db:migrate": "npm run migrate -w @jab/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @jab/db",
    "db:migrate:status": "npm run migrate:status -w @jab/db",
    "db:push": "npm run push -w @jab/db",
    "db:seed": "npm run seed -w @jab/db",
    "db:wipe-app-data": "node packages/db/scripts/wipe-app-data.mjs",
    "db:studio": "npm run studio -w @jab/db",
    "db:validate": "npm run validate -w @jab/db",
    "dev:api": "npm run dev -w @jab/server",
    "e2e:api": "tsx scripts/e2e-api.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "overrides": {
    "lightningcss": "1.33.0"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "lightningcss": "1.33.0"
  }
}
