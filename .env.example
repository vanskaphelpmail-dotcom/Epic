# =============================================================================
# THE OUDS — local + Vercel
# Copy this file to .env and fill real values. Never commit .env.
# =============================================================================

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL — pooled URL for the app, direct (non-pooler) for migrations
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Cloudinary (product photos on Vercel)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name

WEB_PORT=3000
PORT=3000
NEXT_PUBLIC_API_URL=/api

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=replace-with-another-long-random-secret
INITIAL_ADMIN_EMAIL=admin@theouds.co.uk
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
INITIAL_STAFF_PASSWORD=Staff123!

# Vercel: set the same DATABASE_URL, DIRECT_URL, CLOUDINARY_URL, JWT_SECRET,
# INITIAL_ADMIN_EMAIL, INITIAL_ADMIN_PASSWORD — then Redeploy.
